# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Execution is deliberately disabled until the deployment ladder promotes it.
TRADING_MODE=research

# Solana / Jupiter endpoints can be overridden for local testing.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_BASE=https://api.jup.ag

# Never place private keys in this file. Live credentials must be injected
# through an isolated secret store and remain inaccessible to research agents.
TRADING_WALLET_PUBLIC_KEY=

# Risk guardrails (immutable defaults; changes require an explicit policy review).
MAX_POSITION_FRACTION=0.10
MAX_PORTFOLIO_DRAWDOWN=0.15
MAX_DAILY_LOSS_FRACTION=0.03
MIN_CASH_RESERVE_FRACTION=0.20
