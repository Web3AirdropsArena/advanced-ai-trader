# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Execution is deliberately disabled until the deployment ladder promotes it.
TRADING_MODE=research

# Solana / Jupiter endpoints can be overridden for local testing.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_BASE=https://api.jup.ag/swap/v2

# Required for Jupiter routing & quotes. Never commit the real key.
JUPITER_API_KEY="your_jup_developer_portal_key"

# Native wallet public address for telemetry tracking only.
# Never place private keys, seed phrases, or signing material here.
TRADING_WALLET_PUBLIC_KEY="your_solana_public_address"

# Base trading-pair mints. USDC is the canonical portfolio accounting unit;
# SOL remains available as a native/WSOL trading base asset.
BASE_ACCOUNTING_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
BASE_STABLE_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v" # USDC
SOL_MINT="So11111111111111111111111111111111111111112"        # WSOL

# Risk guardrails (immutable defaults; changes require an explicit policy review).
MAX_POSITION_FRACTION=0.10
MAX_PORTFOLIO_DRAWDOWN=0.15
MAX_DAILY_LOSS_FRACTION=0.03
MIN_CASH_RESERVE_FRACTION=0.20
